{
  "name": "yatra",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@yatra/web",
    "dev:mobile": "turbo run dev --filter=@yatra/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:shared": "turbo run test --filter=@yatra/shared"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
