{
  "expo": {
    "name": "Jal Khoj",
    "slug": "jal-khoj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jalkhoj",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B1F3B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jalkhoj.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B1F3B"
      },
      "package": "com.jalkhoj.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "jalkhoj",
              "host": "join"
            },
            {
              "scheme": "yatra",
              "host": "join"
            },
            {
              "scheme": "https",
              "host": "*.jalkhoj.app",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B35",
          "sounds": ["default"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
