NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PNR_API_BASE_URL=https://your-pnr-api.example.com
PNR_API_KEY=your-pnr-api-key

# Indian Railways PNR Gateways (Multiple Supported)
# 1. IndianRailAPI (http://indianrailapi.com/api/v2/PNRCheck/apikey/<apikey>/PNRNumber/<pnrNumber>/Route/1/)
INDIAN_RAIL_API_KEY=your-indianrailapi-key

# 2. CRIS Pravah Enterprise Developer Gateway (https://crisapis.indianrail.gov.in/devportal)
CRIS_API_URL=https://crisapis.indianrail.gov.in/devportal
CRIS_API_TOKEN=your-cris-bearer-token

# 3. RapidAPI IRCTC (https://rapidapi.com/irctc1)
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Firebase Web Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
